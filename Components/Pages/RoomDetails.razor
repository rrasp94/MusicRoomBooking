@page "/rooms/{Id:int}"
@inject ApplicationDbContext Db

<PageTitle>Room details</PageTitle>

@if (loading)
{
    <p>Loading...</p>
}
else if (room is null)
{
    <h1>Room not found</h1>
    <p>This room is not available.</p>
    <a href="/rooms" class="btn btn-secondary">Back to rooms</a>
}
else
{
    <h1>@room.Name</h1>

    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrWhiteSpace(room.ImageUrl))
            {
                <img src="@room.ImageUrl" class="img-fluid rounded mb-3" alt="@room.Name" />
            }
        </div>
        <div class="col-md-6">
            <p>@room.Description</p>
            <p><strong>Capacity:</strong> @room.Capacity people</p>

            <h4>Equipment</h4>
            @if (room.EquipmentItems.Count == 0)
            {
                <p>No equipment listed for this room.</p>
            }
            else
            {
                <ul>
                    @foreach (var item in room.EquipmentItems.OrderBy(e => e.Name))
                    {
                        <li>@item.Name</li>
                    }
                </ul>
            }

            <AuthorizeView>
                <Authorized>
                    <a href="@($"/rooms/{room.Id}/reserve")" class="btn btn-primary">Book this room</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login" class="btn btn-primary">Log in to book</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="/rooms" class="btn btn-secondary">Back to rooms</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Room? room;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        room = await Db.Rooms
            .Include(r => r.EquipmentItems)
            .FirstOrDefaultAsync(r => r.Id == Id && r.IsActive);
        loading = false;
    }
}
