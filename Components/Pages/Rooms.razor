@page "/rooms"
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Rooms</PageTitle>

<h1>Rooms</h1>
<p>Browse our music rooms and book your practice time.</p>

@if (rooms is null)
{
    <p>Loading...</p>
}
else if (rooms.Count == 0)
{
    <p>No rooms available at the moment.</p>
}
else
{
    <div class="row">
        @foreach (var room in rooms)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(room.ImageUrl))
                    {
                        <img src="@room.ImageUrl" class="card-img-top" alt="@room.Name" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@room.Name</h5>
                        <p class="card-text">Capacity: @room.Capacity</p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a href="@($"/rooms/{room.Id}")" class="btn btn-primary w-100">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="PreviousPage">&laquo; Prev</button>
        <span>Page @currentPage of @totalPages</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= totalPages)" @onclick="NextPage">Next &raquo;</button>
    </div>
}

@code {
    private const int PageSize = 6;
    private int currentPage = 1;
    private int totalPages = 1;
    private List<Room>? rooms;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage();
    }

    private async Task LoadPage()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var total = await db.Rooms.CountAsync(r => r.IsActive);
        totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);

        rooms = await db.Rooms
            .AsNoTracking()
            .Where(r => r.IsActive)
            .OrderBy(r => r.Name)
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadPage();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadPage();
        }
    }
}
