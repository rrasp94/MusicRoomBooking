@page "/admin/rooms/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Edit room</PageTitle>

<h1>Edit room</h1>

@if (room is null)
{
    <p>Room not found.</p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="room" OnValidSubmit="SaveRoom">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText @bind-Value="room.Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea @bind-Value="room.Description" class="form-control" rows="4" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Capacity</label>
                    <InputNumber @bind-Value="room.Capacity" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Image URL</label>
                    <InputText @bind-Value="room.ImageUrl" class="form-control" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox @bind-Value="room.IsActive" class="form-check-input" id="isActive" />
                    <label class="form-check-label" for="isActive">Active</label>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a href="/admin/rooms" class="btn btn-secondary">Cancel</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Room? room;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        room = await db.Rooms.AsNoTracking().FirstOrDefaultAsync(r => r.Id == Id);
    }

    private async Task SaveRoom()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Rooms.Update(room!);
        await db.SaveChangesAsync();
        Navigation.NavigateTo("/admin/rooms");
    }
}
