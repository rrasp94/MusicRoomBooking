@page "/admin/rooms/{RoomId:int}/equipment"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Room equipment</PageTitle>

@if (room is null)
{
    <p>Room not found.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Equipment – @room.Name</h1>
        <a href="/admin/rooms" class="btn btn-secondary">Back to rooms</a>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">@(editing.Id == 0 ? "Add equipment" : "Edit equipment")</h5>
                    <EditForm Model="editing" OnValidSubmit="SaveEquipment">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="editing.Name" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="editing.Description" class="form-control" rows="2" />
                        </div>

                        <button type="submit" class="btn btn-primary">Save</button>
                        @if (editing.Id != 0)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="ResetForm">Cancel</button>
                        }
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            @if (equipment.Count == 0)
            {
                <p>No equipment added yet.</p>
            }
            else
            {
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in equipment)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditEquipment(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEquipment(item)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int RoomId { get; set; }

    private Room? room;
    private List<Equipment> equipment = new();

    // A single form model is reused for both adding (Id == 0) and editing an existing item.
    private Equipment editing = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        room = await db.Rooms.AsNoTracking().FirstOrDefaultAsync(r => r.Id == RoomId);
        if (room is not null)
        {
            equipment = await db.Equipment
                .AsNoTracking()
                .Where(e => e.RoomId == RoomId)
                .OrderBy(e => e.Name)
                .ToListAsync();
        }
        editing.RoomId = RoomId;
    }

    private async Task SaveEquipment()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (editing.Id == 0)
        {
            db.Equipment.Add(editing);
        }
        else
        {
            db.Equipment.Update(editing);
        }
        await db.SaveChangesAsync();

        equipment = await db.Equipment
            .AsNoTracking()
            .Where(e => e.RoomId == RoomId)
            .OrderBy(e => e.Name)
            .ToListAsync();
        ResetForm();
    }

    private void EditEquipment(Equipment item)
    {
        // Edit a detached copy so cancelling doesn't leave the tracked entity with unsaved changes.
        editing = new Equipment
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            RoomId = item.RoomId
        };
    }

    private async Task DeleteEquipment(Equipment item)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Equipment.FindAsync(item.Id);
        if (entity is not null)
        {
            db.Equipment.Remove(entity);
            await db.SaveChangesAsync();
        }
        equipment.Remove(item);
        if (editing.Id == item.Id)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        editing = new Equipment { RoomId = RoomId };
    }
}
