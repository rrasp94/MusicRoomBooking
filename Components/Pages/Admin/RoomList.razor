@page "/admin/rooms"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@inject ILogger<RoomList> Logger

<PageTitle>Manage rooms</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage rooms</h1>
    <a href="/admin/rooms/create" class="btn btn-primary">Add room</a>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (rooms is null)
{
    <p>Loading...</p>
}
else if (rooms.Count == 0)
{
    <p>No rooms yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Capacity</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in rooms)
            {
                <tr>
                    <td>@room.Name</td>
                    <td>@room.Capacity</td>
                    <td>
                        @if (room.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a href="@($"/admin/rooms/{room.Id}/equipment")" class="btn btn-sm btn-outline-secondary">Equipment</a>
                        <a href="@($"/admin/rooms/edit/{room.Id}")" class="btn btn-sm btn-outline-primary">Edit</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRoom(room)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="PreviousPage">&laquo; Prev</button>
        <span>Page @currentPage of @totalPages</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= totalPages)" @onclick="NextPage">Next &raquo;</button>
    </div>
}

@code {
    private const int PageSize = 10;
    private int currentPage = 1;
    private int totalPages = 1;
    private List<Room>? rooms;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage();
    }

    private async Task LoadPage()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var total = await db.Rooms.CountAsync();
        totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);

        rooms = await db.Rooms
            .AsNoTracking()
            .OrderBy(r => r.Name)
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadPage();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadPage();
        }
    }

    private async Task DeleteRoom(Room room)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete room \"{room.Name}\"?");
        if (!confirmed)
        {
            return;
        }

        errorMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Rooms.FindAsync(room.Id);
            if (entity is not null)
            {
                db.Rooms.Remove(entity);
                await db.SaveChangesAsync();
            }
            await LoadPage();
        }
        catch (DbUpdateException ex)
        {
            // Deleting a room fails while it still has reservations or reviews (delete behaviour is Restrict).
            Logger.LogError(ex, "Failed to delete room {RoomId}", room.Id);
            errorMessage = "This room cannot be deleted because it still has reservations or reviews.";
        }
    }
}
