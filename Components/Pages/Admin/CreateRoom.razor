@page "/admin/rooms/create"
@attribute [Authorize(Roles = "Admin")]
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<PageTitle>Add room</PageTitle>

<h1>Add room</h1>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="room" OnValidSubmit="SaveRoom">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText @bind-Value="room.Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea @bind-Value="room.Description" class="form-control" rows="4" />
            </div>
            <div class="mb-3">
                <label class="form-label">Capacity</label>
                <InputNumber @bind-Value="room.Capacity" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Image URL</label>
                <InputText @bind-Value="room.ImageUrl" class="form-control" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="room.IsActive" class="form-check-input" id="isActive" />
                <label class="form-check-label" for="isActive">Active</label>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/admin/rooms" class="btn btn-secondary">Cancel</a>
        </EditForm>
    </div>
</div>

@code {
    private Room room = new() { IsActive = true };

    private async Task SaveRoom()
    {
        Db.Rooms.Add(room);
        await Db.SaveChangesAsync();
        Navigation.NavigateTo("/admin/rooms");
    }
}
