@page "/admin/reservations"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Manage reservations</PageTitle>

<h1>Manage reservations</h1>

@if (reservations is null)
{
    <p>Loading...</p>
}
else if (reservations.Count == 0)
{
    <p>There are no reservations.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Room</th>
                <th>User</th>
                <th>Start</th>
                <th>End</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in reservations)
            {
                <tr>
                    <td>@r.Room?.Name</td>
                    <td>@r.User?.Email</td>
                    <td>@r.StartTime.ToString("g")</td>
                    <td>@r.EndTime.ToString("g")</td>
                    <td class="text-end">
                        <a href="@($"/admin/reservations/edit/{r.Id}")" class="btn btn-sm btn-outline-primary">Edit</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(r)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="PreviousPage">&laquo; Prev</button>
        <span>Page @currentPage of @totalPages</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= totalPages)" @onclick="NextPage">Next &raquo;</button>
    </div>
}

@code {
    private const int PageSize = 10;
    private int currentPage = 1;
    private int totalPages = 1;
    private List<Reservation>? reservations;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage();
    }

    private async Task LoadPage()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var total = await db.Reservations.CountAsync();
        totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);

        reservations = await db.Reservations
            .AsNoTracking()
            .Include(r => r.Room)
            .Include(r => r.User)
            .OrderByDescending(r => r.StartTime)
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadPage();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadPage();
        }
    }

    private async Task Delete(Reservation reservation)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this reservation?");
        if (!confirmed)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Reservations.FindAsync(reservation.Id);
        if (entity is not null)
        {
            db.Reservations.Remove(entity);
            await db.SaveChangesAsync();
        }
        await LoadPage();
    }
}
