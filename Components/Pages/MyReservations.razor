@page "/my-reservations"
@attribute [Authorize]
@using System.Security.Claims
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider

<PageTitle>My reservations</PageTitle>

<h1>My reservations</h1>

@if (reservations is null)
{
    <p>Loading...</p>
}
else if (reservations.Count == 0)
{
    <p>You have no reservations yet. <a href="/rooms">Browse rooms</a> to make one.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Room</th>
                <th>Start</th>
                <th>End</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in reservations)
            {
                <tr>
                    <td>@r.Room?.Name</td>
                    <td>@r.StartTime.ToString("g")</td>
                    <td>@r.EndTime.ToString("g")</td>
                    <td class="text-end">
                        @if (r.StartTime > DateTime.UtcNow)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Cancel(r)">Cancel</button>
                        }
                        else
                        {
                            <span class="text-muted">Past</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="PreviousPage">&laquo; Prev</button>
        <span>Page @currentPage of @totalPages</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= totalPages)" @onclick="NextPage">Next &raquo;</button>
    </div>
}

@code {
    private const int PageSize = 10;
    private int currentPage = 1;
    private int totalPages = 1;
    private List<Reservation>? reservations;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await LoadPage();
    }

    private async Task LoadPage()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var total = await db.Reservations.CountAsync(r => r.UserId == userId);
        totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);

        reservations = await db.Reservations
            .AsNoTracking()
            .Include(r => r.Room)
            .Where(r => r.UserId == userId)
            .OrderByDescending(r => r.StartTime)
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadPage();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadPage();
        }
    }

    private async Task Cancel(Reservation reservation)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Reservations.FindAsync(reservation.Id);

        // Only delete the reservation if it actually belongs to the current user.
        if (entity is not null && entity.UserId == userId)
        {
            db.Reservations.Remove(entity);
            await db.SaveChangesAsync();
            await LoadPage();
        }
    }
}
