@page "/"

<PageTitle>Home</PageTitle>

<div class="p-5 mb-4 rounded-3 text-white home-hero">
    <h1 class="display-5">Music Room Booking</h1>
    <p class="lead">
        Book rehearsal and practice rooms for your band or solo sessions.
        Browse our rooms, check the equipment and reserve a time slot.
    </p>
    <a href="/rooms" class="btn btn-primary btn-lg">Browse rooms</a>
</div>

<style>
    .home-hero {
        background-image: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url('images/hero.jpg');
        background-size: cover;
        background-position: center;
    }
</style>

<div class="row">
    <div class="col-md-4">
        <h4>Find a room</h4>
        <p>Look through the available music rooms and see what each one offers.</p>
    </div>
    <div class="col-md-4">
        <h4>Reserve a slot</h4>
        <p>Pick a free time slot and book the room for your session.</p>
    </div>
    <div class="col-md-4">
        <h4>Leave a review</h4>
        <p>After using a room, share a rating and comment to help others.</p>
    </div>
</div>
